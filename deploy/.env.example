# Timezone
TZ=Asia/Shanghai

# Exposed HTTP port on server
HTTP_PORT=80

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=report
MYSQL_USER=report_user
MYSQL_PASSWORD=change_me_report_password

# Mail (required by backend)
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your_mail@qq.com
SPRING_MAIL_PASSWORD=your_mail_auth_code

# App mail fields
APP_MAIL_FROM_DISPLAY_NAME=实验报告系统
APP_MAIL_SUBJECT=实验报告系统验证码
APP_MAIL_DEADLINE_REMINDER_HOURS=24
APP_MAIL_DEADLINE_REMINDER_CRON=0 0/30 * * * ?
