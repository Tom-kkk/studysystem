{
  "info": {
    "_postman_id": "8fce39f1-58af-40ee-a7be-bf1d4baf4458",
    "name": "stu_backend-口令重置和邮箱设置",
    "description": "导入 Apifox 后，先调用“发送邮箱验证码”，从响应头 Set-Cookie 中复制 JSESSIONID 到变量 jsessionid，再调用后续接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "首次登录设置邮箱和新密码",
      "item": [
        {
          "name": "1-发送邮箱验证码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/email/checkcode?email={{registerEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "email",
                "checkcode"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{registerEmail}}"
                }
              ]
            },
            "description": "成功后请在响应头中复制 Set-Cookie 的 JSESSIONID，填入变量 jsessionid。"
          },
          "response": []
        },
        {
          "name": "2-首次登录设置密码和邮箱",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "JSESSIONID={{jsessionid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"101001\",\n  \"oldPass\": \"101001\",\n  \"newPass\": \"123456\",\n  \"confirmPass\": \"123456\",\n  \"email\": \"{{registerEmail}}\",\n  \"emailCheckcode\": \"请填邮箱收到的验证码\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/set-password-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "set-password-email"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "忘记密码重置",
      "item": [
        {
          "name": "1-发送邮箱验证码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/email/checkcode?email={{registerEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "email",
                "checkcode"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{registerEmail}}"
                }
              ]
            },
            "description": "成功后请在响应头中复制 Set-Cookie 的 JSESSIONID，填入变量 jsessionid。"
          },
          "response": []
        },
        {
          "name": "2-忘记密码重置",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "JSESSIONID={{jsessionid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"101001\",\n  \"email\": \"{{registerEmail}}\",\n  \"emailCheckcode\": \"请填邮箱收到的验证码\",\n  \"newPass\": \"123456\",\n  \"confirmPass\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forget-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forget-password"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "jsessionid",
      "value": "",
      "type": "string"
    },
    {
      "key": "registerEmail",
      "value": "321455764@qq.com",
      "type": "string"
    }
  ]
}
